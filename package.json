{
  "name": "frantssb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:articles && varlock run -- vp dev --port 3000",
    "prebuild": "pnpm generate:resume",
    "build": "pnpm generate:articles && varlock run -- vp build && node --import=tsx scripts/package-deployment.ts",
    "start": "varlock run -- node .output/server/index.mjs",
    "preview": "vp preview",
    "check": "pnpm generate:localization && APP_ENV=test vp check",
    "knip": "pnpm generate:localization && knip",
    "test": "pnpm generate:localization && APP_ENV=test vp test",
    "test:screenshots": "playwright test",
    "test:screenshots:update": "playwright test --update-snapshots",
    "generate:articles": "node --import=tsx scripts/generate-articles.ts",
    "generate:article-social": "pnpm generate:articles",
    "articles:sync": "varlock run -- node .output/server/articles-sync.mjs .output/server/articles.json",
    "articles:sync:dev": "pnpm generate:articles && varlock run -- node --import=tsx scripts/articles-sync.ts",
    "generate:favicon": "node scripts/generate-favicon.ts",
    "generate:localization": "node scripts/generate-localization.ts",
    "generate:resume": "pnpm generate:localization && node scripts/generate-resume.ts",
    "generate:routes": "tsr generate",
    "generate:social": "node scripts/generate-social.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:studio": "varlock run -- drizzle-kit studio"
  },
  "dependencies": {
    "@ark-ui/solid": "5.39.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@inlang/paraglide-js-solid": "1.0.3",
    "@orpc/client": "2.0.0-beta.41",
    "@orpc/contract": "2.0.0-beta.41",
    "@orpc/openapi": "2.0.0-beta.41",
    "@orpc/ratelimit": "2.0.0-beta.41",
    "@orpc/server": "2.0.0-beta.41",
    "@orpc/tanstack-query": "2.0.0-beta.41",
    "@tabler/icons-solidjs": "3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-pacer": "0.23.0",
    "@tanstack/solid-query": "5.104.1",
    "@tanstack/solid-router": "1.170.37",
    "@tanstack/solid-router-ssr-query": "1.167.3",
    "@tanstack/solid-start": "1.168.56",
    "@varlock/vite-integration": "^1.5.2",
    "cn": "0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.1",
    "posthog-js": "1.434.17",
    "solid-js": "1.9.15",
    "tailwindcss": "^4.3.3",
    "valibot": "1.5.0",
    "varlock": "^1.21.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.63.0",
    "@posthog/rollup-plugin": "1.6.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@takumi-rs/core": "2.14.0",
    "@tanstack/highlight": "^1.0.0",
    "@tanstack/router-cli": "^1.167.39",
    "@types/pg": "8.23.1",
    "@vitest/browser-playwright": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "railway": "3.12.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  }
}

{
  "name": "frantssb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm generate:article-social && varlock run -- vp dev --port 3000",
    "prebuild": "pnpm generate:resume",
    "build": "pnpm generate:article-social && varlock run -- vp build",
    "start": "varlock run -- node .output/server/index.mjs",
    "preview": "vp preview",
    "check": "pnpm generate:localization && APP_ENV=test vp check",
    "knip": "pnpm generate:localization && knip",
    "test": "pnpm generate:localization && APP_ENV=test vp test",
    "test:screenshots": "playwright test",
    "test:screenshots:update": "playwright test --update-snapshots",
    "generate:article-social": "node --import=tsx scripts/generate-article-social.ts",
    "generate:favicon": "node scripts/generate-favicon.ts",
    "generate:localization": "node scripts/generate-localization.ts",
    "generate:resume": "pnpm generate:localization && node scripts/generate-resume.ts",
    "generate:routes": "tsr generate",
    "generate:social": "node scripts/generate-social.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tabler/icons-solidjs": "3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-router": "1.170.37",
    "@tanstack/solid-start": "1.168.56",
    "@varlock/vite-integration": "^1.5.2",
    "@zag-js/solid": "1.44.0",
    "@zag-js/tooltip": "1.44.0",
    "cn": "0.4.0",
    "nitro": "3.0.260903-beta",
    "posthog-js": "1.434.17",
    "solid-js": "1.9.15",
    "tailwindcss": "^4.3.3",
    "varlock": "^1.21.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.63.0",
    "@posthog/rollup-plugin": "1.6.1",
    "@takumi-rs/core": "2.14.0",
    "@tanstack/highlight": "^1.0.0",
    "@tanstack/router-cli": "^1.167.39",
    "@vitest/browser-playwright": "catalog:",
    "knip": "6.39.0",
    "playwright": "1.63.0",
    "railway": "3.12.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  }
}

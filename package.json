{
  "name": "frantssb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run -- vp dev --port 3000",
    "generate-routes": "tsr generate",
    "check": "APP_ENV=test vp check",
    "test": "APP_ENV=test vp test",
    "build": "varlock run -- vp build",
    "start": "varlock run -- node .output/server/index.mjs",
    "preview": "vp preview",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:studio": "varlock run -- drizzle-kit studio"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/solid-router": "1.170.37",
    "@tanstack/solid-start": "1.168.56",
    "@varlock/vite-integration": "^1.5.2",
    "@zag-js/solid": "^1.44.0",
    "cn": "0.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.0",
    "posthog-js": "1.434.17",
    "posthog-node": "5.54.1",
    "solid-js": "1.9.15",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0",
    "varlock": "^1.21.0"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.39",
    "@types/pg": "8.23.1",
    "@vitest/browser-playwright": "catalog:",
    "drizzle-kit": "1.0.0-rc.4",
    "playwright": "1.63.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  }
}

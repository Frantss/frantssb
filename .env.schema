# @defaultRequired=false @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# ---

# Selects the env-specific file to load, such as .env.test.
# @public @type=enum(development, test, production)
APP_ENV=development

# PostgreSQL connection for the application and Drizzle Kit.
# @required
DATABASE_URL=

# Public PostHog project token used by the browser and server SDKs.
# @public
VITE_POSTHOG_KEY=

# Public browser ingestion URL, usually the same-origin proxy.
# @public
VITE_POSTHOG_HOST=

# @public @type=enum(memory, localStorage+cookie)
VITE_POSTHOG_PERSISTENCE=

# PostHog ingestion host for the server SDK and source-map upload.
# @public
POSTHOG_HOST=

# PostHog project ID for source-map upload.
# @public
POSTHOG_PROJECT_ID=

# Personal API key for source-map upload.
POSTHOG_API_KEY=

# Optional database used only by persistence tests.
TEST_DATABASE_URL=

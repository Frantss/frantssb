# @defaultRequired=false @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# ---

# Selects the env-specific file to load, such as .env.test.
# @public @type=enum(development, test, production)
APP_ENV=development

# Public PostHog project token used by the browser SDK.
# @public
VITE_POSTHOG_KEY=

# Public PostHog ingestion URL, such as https://us.i.posthog.com.
# @public
VITE_POSTHOG_HOST=

# @public @type=enum(memory, localStorage+cookie)
VITE_POSTHOG_PERSISTENCE=

# PostHog host for source-map upload.
# @public
POSTHOG_HOST=

# PostHog project ID for source-map upload.
# @public
POSTHOG_PROJECT_ID=

# Personal API key for source-map upload.
POSTHOG_API_KEY=
